{
  "name": "FIT4110 A4 - AI Vision Service",
  "version": "1.0.0",
  "description": "AI Vision Service for Smart Campus Operations Platform - Product A",
  "private": true,
  "scripts": {
    "mock:ai": "prism mock contracts/ai-vision.openapi.yaml --host 0.0.0.0 --port 4010",
    "lint:openapi": "spectral lint contracts/*.yaml",
    "test:local": "newman run postman/collections/ai-vision.postman_collection.json -e postman/environments/ai-vision-local.postman_environment.json -r cli,junit,htmlextra --reporter-junit-export reports/ai-vision-test.xml --reporter-htmlextra-export reports/ai-vision-test.html",
    "test:compose": "newman run postman/collections/ai-vision.postman_collection.json -e postman/environments/ai-vision-local.postman_environment.json -r cli,junit,htmlextra --reporter-junit-export reports/ai-vision-compose.xml --reporter-htmlextra-export reports/ai-vision-compose.html"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.10.0",
    "@stoplight/spectral-cli": "^6.13.1",
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
