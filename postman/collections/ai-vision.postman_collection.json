    {
      "name": "Batch Analysis",
      "item": [
        {
          "name": "POST /vision/batch - Analyze multiple images",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has batch results', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('results');",
                  "    pm.expect(jsonData).to.have.property('total_images');",
                  "    pm.expect(jsonData).to.have.property('processed');",
                  "});",
                  "",
                  "pm.test('Results array matches total_images', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.results.length).to.equal(jsonData.total_images);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"images\": [\n        {\n            \"camera_id\": \"cam-gate-01\",\n            \"image_url\": \"http://example.com/frame1.jpg\",\n            \"timestamp\": \"{{$timestamp}}\"\n        },\n        {\n            \"camera_id\": \"cam-parking-01\",\n            \"image_url\": \"http://example.com/frame2.jpg\",\n            \"timestamp\": \"{{$timestamp}}\"\n        },\n        {\n            \"camera_id\": \"cam-main-01\",\n            \"image_url\": \"http://example.com/frame3.jpg\",\n            \"timestamp\": \"{{$timestamp}}\"\n        }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/vision/batch",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "batch"]
            },
            "description": "Analyze multiple images in one request"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Statistics",
      "item": [
        {
          "name": "GET /vision/stats - Get vision statistics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Stats have correct fields', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('total_analyzed');",
                  "    pm.expect(jsonData).to.have.property('total_objects');",
                  "    pm.expect(jsonData).to.have.property('avg_processing_time_ms');",
                  "    pm.expect(jsonData).to.have.property('top_objects');",
                  "    pm.expect(jsonData).to.have.property('risk_distribution');",
                  "});",
                  "",
                  "pm.test('Numbers are valid', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.total_analyzed).to.be.at.least(0);",
                  "    pm.expect(jsonData.total_objects).to.be.at.least(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/vision/stats",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "stats"]
            },
            "description": "Get vision analysis statistics"
          },
          "response": []
        }
      ]
