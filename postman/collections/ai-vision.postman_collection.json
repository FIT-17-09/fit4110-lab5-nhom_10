              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"camera_id\": \"cam-main-01\",\n    \"image_url\": \"http://example.com/main.jpg\",\n    \"timestamp\": \"{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/vision/analyze",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "analyze"]
            },
            "description": "Analyze image from main entrance"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication Tests",
      "item": [
        {
          "name": "POST /vision/analyze - Missing Authorization (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401 - Missing auth', function() {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Response is problem+json', function() {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "});",
                  "",
                  "pm.test('Error title is Unauthorized', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.title).to.equal('Unauthorized');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
