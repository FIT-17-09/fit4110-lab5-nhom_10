{
  "info": {
    "name": "FIT4110 A4 - AI Vision Service Tests",
    "description": "Postman collection for AI Vision Service - Product A. Test vision analysis endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "a4-dev-token",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET /health - Service Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has correct structure', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('status', 'ok');",
                  "    pm.expect(jsonData).to.have.property('service', 'ai-vision');",
                  "    pm.expect(jsonData).to.have.property('version');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Check AI Vision service health"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Supported Objects",
      "item": [
        {
          "name": "GET /vision/objects - List supported objects",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has objects array', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('objects');",
                  "    pm.expect(jsonData.objects).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Model info is present', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('model_name');",
                  "    pm.expect(jsonData).to.have.property('model_version');",
                  "    pm.expect(jsonData).to.have.property('detection_threshold');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/vision/objects",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "objects"]
            },
            "description": "Get list of supported object classes"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Image Analysis",
      "item": [
        {
          "name": "POST /vision/analyze - Person detected at gate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has correct fields', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('detected');",
                  "    pm.expect(jsonData).to.have.property('objects');",
                  "    pm.expect(jsonData).to.have.property('risk_level');",
                  "    pm.expect(jsonData).to.have.property('processing_time_ms');",
                  "});",
                  "",
                  "pm.test('Risk level is valid', function() {",
                  "    var jsonData = pm.response.json();",
                  "    var validLevels = ['low', 'medium', 'high', 'critical'];",
                  "    pm.expect(validLevels).to.include(jsonData.risk_level);",
                  "});",
                  "",
                  "pm.test('Detection result matches camera', function() {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.detected) {",
                  "        pm.expect(jsonData.objects).to.be.an('array');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}",
                "description": "Bearer token"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"camera_id\": \"cam-gate-01\",\n    \"image_url\": \"http://example.com/frame.jpg\",\n    \"timestamp\": \"{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/vision/analyze",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "analyze"]
            },
            "description": "Analyze image from gate camera - should detect person"
          },
          "response": []
        },
        {
          "name": "POST /vision/analyze - Vehicle detected at parking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Car detected in parking camera', function() {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.detected) {",
                  "        var hasVehicle = jsonData.objects.some(function(obj) {",
                  "            return obj.object === 'car' || obj.object === 'bicycle';",
                  "        });",
                  "        pm.expect(hasVehicle).to.be.true;",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"camera_id\": \"cam-parking-01\",\n    \"image_url\": \"http://example.com/car.jpg\",\n    \"timestamp\": \"{{$timestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/vision/analyze",
              "host": ["{{baseUrl}}"],
              "path": ["vision", "analyze"]
            },
            "description": "Analyze image from parking camera"
          },
          "response": []
        },
